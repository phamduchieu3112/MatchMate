# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# SePay (server-side only — NEVER expose to client)
# Legacy single-host variables (auto-mapped to primary host)
SEPAY_WEBHOOK_API_KEY=your-sepay-webhook-api-key
SEPAY_API_TOKEN=your-optional-sepay-api-token
SEPAY_BANK_ACCOUNT=0123456789
SEPAY_BANK_NAME=MBBank
SEPAY_ACCOUNT_NAME=NGUYEN VAN A
PAYMENT_CODE_PREFIX=KEO

# Scalable Multi-Host Payment & SePay Configs (supports unlimited N hosts, keyed by lowercase email)
# Format: JSON object keyed by host email OR JSON array of host objects.
# HOST_PAYMENT_CONFIGS_JSON='{"host@example.com":{"bankCode":"MBBank","accountNumber":"0123456789","accountName":"NGUYEN VAN A","sepayApiToken":"token-1","sepayWebhookSecret":"secret-1","transferPrefix":"H01"},"friend@example.com":{"bankCode":"VCB","accountNumber":"9876543210","accountName":"NGUYEN VAN B","sepayApiToken":"token-2","sepayWebhookSecret":"secret-2","transferPrefix":"FR1"}}'
# HOST_PAYMENT_FALLBACK_EMAIL=host@example.com
# HOST_PAYMENT_FALLBACK_MODE=default_host

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key
